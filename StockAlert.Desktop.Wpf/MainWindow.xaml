<Window x:Class="StockAlert.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockAlert Desktop | Inventory" Width="1360" Height="840"
        MinWidth="980" MinHeight="650" Background="#F9FAFB" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="SidebarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="18,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="43"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="24,24,14,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="StockAlert" FontSize="24" FontWeight="Bold" Foreground="#60A5FA"/>
                            <Border Margin="9,6,0,0" Padding="7,2" Background="#1E3A8A" CornerRadius="4">
                                <TextBlock Text="DESKTOP" Foreground="#BFDBFE" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Inventory control &amp; reconciliation" Foreground="#64748B" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18">
                    <TextBlock Text="More modules coming to desktop" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,4">
                        <TextBlock Style="{StaticResource SidebarText}" Text="Dashboard"/>
                        <Border Background="#2563EB" CornerRadius="7" Margin="0,1">
                            <TextBlock Text="Inventory" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="18,12"/>
                        </Border>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Stock Movements"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Stocktakes"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Suppliers"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Quotes"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Customers"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Staff"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Sales"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Reports"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Business Settings"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Audit Logs"/>
                        <TextBlock Style="{StaticResource SidebarText}" Text="Offline Queue"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Inventory management" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Stock Inventory" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0"/>
                        <TextBlock Text="Manage products, scan barcodes and print labels" Foreground="#6B7280" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="API URL" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ApiUrlBox" Text="https://localhost:7001" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EmailBox" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="LoginPasswordBox" Padding="11,9" BorderBrush="#CBD5E1" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Sign In" Click="Login_Click" Margin="0,0,8,0"/>
                            <Button Content="Refresh" Click="LoadProducts_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,18">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Print Barcode Label" Margin="12,0,0,0" Click="PrintLabel_Click"/>
                        <Button DockPanel.Dock="Right" Content="Edit Product" Margin="12,0,0,0" Click="EditProduct_Click"/>
                        <Button DockPanel.Dock="Right" Content="Add Product" Margin="12,0,0,0" Click="AddProduct_Click"/>
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" ToolTip="Search name, category, supplier or scan barcode" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="11" Padding="6" MinHeight="300">
                    <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="1.5*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="Price (R)" Binding="{Binding Price, StringFormat=N2}" Width="*"/>
                            <DataGridTextColumn Header="On hand" Binding="{Binding StockQuantity}" Width="*"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#64748B" Margin="3,14,0,0" Text="Connect to the API to load inventory."/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>